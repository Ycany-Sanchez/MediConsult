@rendermode InteractiveServer

<header class="w-full bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-neutral-100 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Brand Logo with + Icon -->
        <a href="/" class="group flex items-center transition-transform duration-300 ease-spring hover:scale-105">
            <AppLogo />
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-neutral-600">
            <a href="/" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">Home</a>
            <a href="/#about" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">About Us</a>
            <a href="/#services" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">Services</a>
            <a href="/how-it-works" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">How It Works</a>
            <a href="/#pricing" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">Pricing</a>
            <a href="/reviews" class="relative hover:text-black transition-colors duration-200 py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-neutral-900 hover:after:w-full after:transition-all after:duration-300 after:ease-spring">Reviews</a>
        </nav>

        <!-- Desktop Action Buttons -->
        <div class="hidden md:flex items-center space-x-3">
            <a href="/login" class="motion-btn motion-btn-outline inline-flex items-center justify-center px-6 py-2 rounded-full border border-neutral-300 text-sm font-medium text-neutral-900 hover:border-black transition">
                Login
            </a>
            <a href="/signup" class="motion-btn motion-btn-dark inline-flex items-center justify-center px-6 py-2 rounded-full bg-brand-dark text-sm font-medium text-white hover:bg-neutral-800 transition">
                Sign Up
            </a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button type="button" 
                @onclick="() => isMenuOpen = !isMenuOpen" 
                class="md:hidden p-2.5 rounded-xl border border-neutral-200 text-neutral-700 hover:text-black hover:border-neutral-400 focus:outline-none transition-all duration-200 active:scale-95"
                aria-label="Toggle navigation menu">
            @if (isMenuOpen)
            {
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            }
            else
            {
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            }
        </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    @if (isMenuOpen)
    {
        <div class="md:hidden bg-white border-b border-neutral-200 px-6 py-5 space-y-4 accordion-body-enter">
            <nav class="flex flex-col space-y-3 text-sm font-medium text-neutral-700">
                <a href="/" @onclick="CloseMenu" class="hover:text-black transition">Home</a>
                <a href="/#about" @onclick="CloseMenu" class="hover:text-black transition">About Us</a>
                <a href="/#services" @onclick="CloseMenu" class="hover:text-black transition">Services</a>
                <a href="/how-it-works" @onclick="CloseMenu" class="hover:text-black transition">How It Works</a>
                <a href="/#pricing" @onclick="CloseMenu" class="hover:text-black transition">Pricing</a>
                <a href="/reviews" @onclick="CloseMenu" class="hover:text-black transition">Reviews</a>
            </nav>
            <div class="pt-4 border-t border-neutral-100 flex flex-col space-y-2">
                <a href="/login" @onclick="CloseMenu" class="motion-btn motion-btn-outline w-full text-center py-2.5 rounded-xl border border-neutral-300 text-sm font-medium text-neutral-900">
                    Login
                </a>
                <a href="/signup" @onclick="CloseMenu" class="motion-btn motion-btn-dark w-full text-center py-2.5 rounded-xl bg-brand-dark text-white text-sm font-medium">
                    Sign Up
                </a>
            </div>
        </div>
    }
</header>

@code {
    private bool isMenuOpen = false;

    private void CloseMenu()
    {
        isMenuOpen = false;
    }
}