@rendermode InteractiveServer

<div class="w-full bg-[#0D1016] text-white rounded-3xl p-6 sm:p-10 border border-neutral-800 shadow-2xl relative overflow-hidden select-none">
    <!-- Subtle Ambient Stage Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-64 bg-brand-lime/10 blur-[100px] rounded-full pointer-events-none"></div>

    <!-- Header Section -->
    <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6">
        <div>
            <div class="flex items-center space-x-2.5 mb-2.5">
                <span class="inline-block px-3 py-1 rounded-lg bg-brand-lime text-neutral-950 text-xs font-bold uppercase tracking-wider shadow-xs">
                    Verified Stories
                </span>
                <span class="text-xs text-neutral-400 font-medium">
                    @FilteredReviews.Count verified consultations
                </span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
                Verified Patient Testimonials
            </h2>
            <p class="text-neutral-400 text-xs sm:text-sm mt-1 max-w-lg">
                Direct feedback and clinical recovery results from consultations nationwide.
            </p>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2">
            @foreach (var cat in categories)
            {
                <button type="button"
                        @onclick="() => SelectCategory(cat)"
                        class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 ease-spring @(selectedCategory == cat ? "bg-brand-lime text-neutral-950 font-bold shadow-sm scale-[1.02]" : "bg-neutral-900 text-neutral-400 hover:text-white hover:bg-neutral-800 border border-neutral-800")">
                    @cat
                </button>
            }
        </div>
    </div>

    <!-- 3D Coverflow Stage Viewport -->
    <div class="coverflow-viewport my-4">
        @for (int i = 0; i < FilteredReviews.Count; i++)
        {
            var index = i;
            var review = FilteredReviews[index];
            var offset = index - activeIndex;
            var isCenter = (offset == 0);
            var cardStyle = GetCard3DStyle(offset);

            <div class="coverflow-card"
                 style="@cardStyle"
                 @onclick="() => SelectCard(index)">
                
                @if (isCenter)
                {
                    <!-- Active Center Card: Light Theme, Elevated, High Contrast, Chamfered Corner -->
                    <div class="chamfer-clip bg-neutral-300 p-[1.5px] w-full h-full shadow-[0_30px_70px_-15px_rgba(0,0,0,0.8)]">
                        <div class="chamfer-clip-sm bg-[#ECEFF2] text-neutral-950 w-full h-full p-7 sm:p-9 flex flex-col justify-between">
                            <div>
                                <!-- Top Bar: Patient Avatar + Star Rating & Verification -->
                                <div class="flex items-start justify-between gap-3 mb-4">
                                    <div class="flex items-center space-x-3.5">
                                        @if (!string.IsNullOrEmpty(review.AvatarUrl))
                                        {
                                            <img src="@review.AvatarUrl" 
                                                 alt="@review.Author" 
                                                 class="w-13 h-13 rounded-2xl object-cover border border-neutral-300 shadow-sm flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-13 h-13 rounded-2xl bg-brand-lime text-neutral-950 font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm">
                                                @review.Initials
                                            </div>
                                        }
                                        <div>
                                            <div class="flex items-center space-x-1">
                                                @for (int s = 0; s < 5; s++)
                                                {
                                                    <svg class="w-4 h-4 fill-amber-400 text-amber-400 flex-shrink-0" viewBox="0 0 24 24">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                }
                                            </div>
                                            <span class="text-[11px] font-bold text-neutral-800">5.0 Out of 5.0</span>
                                        </div>
                                    </div>

                                    <!-- Verified Badge -->
                                    <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full text-[11px] font-bold bg-brand-lime text-neutral-950 border border-black/10 shadow-2xs">
                                        <svg class="w-3.5 h-3.5 text-neutral-950 flex-shrink-0 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span>Verified</span>
                                    </span>
                                </div>

                                <!-- Quote Body (Typographic quotes, Max 3 lines, zero em-dashes) -->
                                <p class="text-lg sm:text-xl font-bold text-neutral-950 leading-snug tracking-tight line-clamp-3 my-4">
                                    “@review.Quote”
                                </p>
                            </div>

                            <!-- Attribution (Zero em-dashes) -->
                            <div class="pt-4 border-t border-neutral-300/80 flex items-center justify-between text-xs">
                                <div>
                                    <p class="font-bold text-neutral-900 leading-tight">@review.Author</p>
                                    <p class="text-[11px] text-neutral-600 mt-0.5">@review.Role</p>
                                </div>
                                <span class="text-[11px] font-semibold text-neutral-500 bg-neutral-200/90 px-3 py-1 rounded-full">
                                    @review.TimeAgo
                                </span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Flanking Cards: Dark Theme, Tilted in 3D Perspective, Chamfered Corner -->
                    <div class="chamfer-clip bg-neutral-800/80 p-[1px] w-full h-full hover:bg-neutral-700 transition-colors">
                        <div class="chamfer-clip-sm bg-[#161B24] text-white w-full h-full p-6 sm:p-7 flex flex-col justify-between">
                            <div>
                                <!-- Top Bar -->
                                <div class="flex items-center space-x-3 mb-4">
                                    @if (!string.IsNullOrEmpty(review.AvatarUrl))
                                    {
                                        <img src="@review.AvatarUrl" 
                                             alt="@review.Author" 
                                             class="w-11 h-11 rounded-xl object-cover border border-neutral-700 opacity-80" />
                                    }
                                    else
                                    {
                                        <div class="w-11 h-11 rounded-xl bg-neutral-800 text-brand-lime font-bold text-xs flex items-center justify-center flex-shrink-0 border border-neutral-700">
                                            @review.Initials
                                        </div>
                                    }
                                    <div>
                                        <div class="flex items-center space-x-1 opacity-80">
                                            @for (int s = 0; s < 5; s++)
                                            {
                                                <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-400" viewBox="0 0 24 24">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                </svg>
                                            }
                                        </div>
                                        <span class="text-[10px] text-neutral-400 font-medium">5.0 Star</span>
                                    </div>
                                </div>

                                <!-- Quote Body (Typographic quotes, Max 3 lines, zero em-dashes) -->
                                <p class="text-base font-medium text-neutral-200 leading-snug tracking-tight line-clamp-3 my-3">
                                    “@review.Quote”
                                </p>
                            </div>

                            <!-- Attribution (Zero em-dashes) -->
                            <div class="pt-3 border-t border-neutral-800 flex items-center justify-between text-xs">
                                <div>
                                    <p class="font-bold text-neutral-200 leading-tight">@review.Author</p>
                                    <p class="text-[10px] text-neutral-400 mt-0.5">@review.Role</p>
                                </div>
                                <span class="text-[10px] text-neutral-500">
                                    @review.TimeAgo
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Bottom Carousel Controls (Matching Reference Image) -->
    <div class="relative z-10 flex items-center justify-center space-x-3 mt-6">
        <!-- Previous Button -->
        <button type="button" 
                @onclick="PrevCard" 
                class="motion-btn w-12 h-12 rounded-xl bg-neutral-900 border border-neutral-700/80 hover:border-brand-lime text-white hover:text-brand-lime flex items-center justify-center transition-all duration-200 active:scale-95 shadow-md group"
                aria-label="Previous testimonial">
            <svg class="w-5 h-5 stroke-[2.5] group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <!-- Position Counter Pill -->
        <div class="px-4 py-2 rounded-xl bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-400 shadow-inner">
            <span class="text-white font-bold">@(activeIndex + 1)</span> / <span>@FilteredReviews.Count</span>
        </div>

        <!-- Next Button -->
        <button type="button" 
                @onclick="NextCard" 
                class="motion-btn w-12 h-12 rounded-xl bg-neutral-900 border border-neutral-700/80 hover:border-brand-lime text-white hover:text-brand-lime flex items-center justify-center transition-all duration-200 active:scale-95 shadow-md group"
                aria-label="Next testimonial">
            <svg class="w-5 h-5 stroke-[2.5] group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public List<ReviewItem>? CustomReviews { get; set; }

    // Start on index 1 so flanking cards are visible on both left and right on load
    private int activeIndex = 1;
    private string selectedCategory = "All Reviews";

    private readonly List<string> categories = new()
    {
        "All Reviews",
        "Video Telehealth",
        "Home Visits",
        "Prescriptions",
        "Diagnostics"
    };

    private List<ReviewItem> defaultReviews = new()
    {
        new ReviewItem
        {
            Author = "Pete Gallagher",
            Role = "Director of Operations, Corporate Wellness",
            Initials = "PG",
            AvatarUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80",
            Title = "Found the right solution",
            Quote = "I have been searching for a telehealth service like MediConsult for years. Direct physician video in minutes and zero pharmacy wait times.",
            Service = "Urgent Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "2 days ago"
        },
        new ReviewItem
        {
            Author = "Andy Kovacs",
            Role = "DevOps Engineer, Cloud Systems",
            Initials = "AK",
            AvatarUrl = "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80",
            Title = "Switched and never looked back",
            Quote = "I switched our household prescriptions to MediConsult two years ago and never looked back. Same-day refills delivered straight to our front porch.",
            Service = "Doorstep Prescriptions",
            Category = "Prescriptions",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "4 days ago"
        },
        new ReviewItem
        {
            Author = "Dr. Clara Morales",
            Role = "Physician & Family Caregiver",
            Initials = "CM",
            AvatarUrl = "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80",
            Title = "Exceptional clinical rigor",
            Quote = "The board-certified home visit doctor arrived on time with comprehensive diagnostic gear. Thorough vitals check and zero waiting room exposure for my father.",
            Service = "Home Doctor Visit",
            Category = "Home Visits",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 week ago"
        },
        new ReviewItem
        {
            Author = "Olivia Campbell",
            Role = "Client Success Lead, HealthTech",
            Initials = "OC",
            AvatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80",
            Title = "Customer care is unparalleled",
            Quote = "The consultation was simple, intuitive, and immediate. The attending physician listened carefully and resolved my prescription in under ten minutes.",
            Service = "Urgent Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "2 weeks ago"
        },
        new ReviewItem
        {
            Author = "Marina Silva",
            Role = "People Operations Partner",
            Initials = "MS",
            AvatarUrl = "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80",
            Title = "Fast diagnostic turnaround",
            Quote = "The phlebotomist arrived punctually at 7:30 AM before my workday started. Lab results posted to my patient dashboard before dinner the same day.",
            Service = "At-Home Lab Diagnostics",
            Category = "Diagnostics",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "3 weeks ago"
        },
        new ReviewItem
        {
            Author = "David Chen",
            Role = "Senior Data Analyst",
            Initials = "DC",
            AvatarUrl = "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=150&auto=format&fit=crop&q=80",
            Title = "Continuous vitals monitoring",
            Quote = "Connected my blood pressure monitor directly into the portal. Dr. Reynolds reviewed my monthly trends and adjusted my dosage with zero friction.",
            Service = "Cardiology Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 month ago"
        },
        new ReviewItem
        {
            Author = "Angela Brooks",
            Role = "Educator & Parent",
            Initials = "AB",
            AvatarUrl = "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80",
            Title = "Saved our family an ER trip",
            Quote = "Having a board-certified pediatrician available at 10 PM on a Sunday saved us a stressful emergency room trip. Calm, empathetic, and exceptionally professional.",
            Service = "Pediatric Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 month ago"
        }
    };

    private List<ReviewItem> AllReviews => CustomReviews ?? defaultReviews;

    private List<ReviewItem> FilteredReviews
    {
        get
        {
            if (selectedCategory == "All Reviews")
            {
                return AllReviews;
            }
            var list = AllReviews.Where(r => r.Category == selectedCategory).ToList();
            return list.Count > 0 ? list : AllReviews;
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        activeIndex = 0;
    }

    private void NextCard()
    {
        if (FilteredReviews.Count == 0) return;
        activeIndex = (activeIndex + 1) % FilteredReviews.Count;
    }

    private void PrevCard()
    {
        if (FilteredReviews.Count == 0) return;
        activeIndex = (activeIndex - 1 + FilteredReviews.Count) % FilteredReviews.Count;
    }

    private void SelectCard(int index)
    {
        activeIndex = index;
    }

    private string GetCard3DStyle(int offset)
    {
        // Active Center Card
        if (offset == 0)
        {
            return "transform: translateX(0px) translateZ(80px) rotateY(0deg) scale(1.04); z-index: 30; opacity: 1; cursor: default;";
        }
        
        // Immediate Right (+1)
        if (offset == 1)
        {
            return "transform: translateX(250px) translateZ(-30px) rotateY(-20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        }
        
        // Immediate Left (-1)
        if (offset == -1)
        {
            return "transform: translateX(-250px) translateZ(-30px) rotateY(20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        }
        
        // Outer Right (+2)
        if (offset == 2)
        {
            return "transform: translateX(470px) translateZ(-80px) rotateY(-28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";
        }
        
        // Outer Left (-2)
        if (offset == -2)
        {
            return "transform: translateX(-470px) translateZ(-80px) rotateY(28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";
        }

        // Hidden beyond (+3, -3, etc.)
        int direction = offset > 0 ? 1 : -1;
        int distance = direction * 660;
        int angle = direction * -35;
        return $"transform: translateX({distance}px) translateZ(-120px) rotateY({angle}deg) scale(0.65); z-index: 0; opacity: 0; pointer-events: none;";
    }

    public class ReviewItem
    {
        public string Author { get; set; } = "";
        public string Role { get; set; } = "";
        public string Initials { get; set; } = "";
        public string AvatarUrl { get; set; } = "";
        public string Title { get; set; } = "";
        public string Quote { get; set; } = "";
        public string Service { get; set; } = "";
        public string Category { get; set; } = "";
        public string Badge { get; set; } = "Verified Patient";
        public double Rating { get; set; } = 5.0;
        public string TimeAgo { get; set; } = "";
    }
}
