    private List<ReviewItem> AllReviews => CustomReviews ?? defaultReviews;

    private List<ReviewItem> FilteredReviews
    {
        get
        {
            if (selectedCategory == "All Reviews")
            {
                return AllReviews;
            }
            var list = AllReviews.Where(r => r.Category == selectedCategory).ToList();
            return list.Count > 0 ? list : AllReviews;
        }
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void CloseDropdown()
    {
        isDropdownOpen = false;
    }

    private void SelectCategoryAndClose(string category)
    {
        selectedCategory = category;
        activeIndex = 0;
        isDropdownOpen = false;
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        activeIndex = 0;
    }

    private void NextCard()
    {
        if (FilteredReviews.Count == 0) return;
        activeIndex = (activeIndex + 1) % FilteredReviews.Count;
    }

    private void PrevCard()
    {
        if (FilteredReviews.Count == 0) return;
        activeIndex = (activeIndex - 1 + FilteredReviews.Count) % FilteredReviews.Count;
    }

    private void SelectCard(int index)
    {
        activeIndex = index;
    }

    public void OpenModal()
    {
        submissionSuccess = false;
        errorMessage = "";
        isModalOpen = true;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isModalOpen = false;
        StateHasChanged();
    }

    private void CloseModalAndFocusCard()
    {
        isModalOpen = false;
        activeIndex = 0;
        selectedCategory = "All Reviews";
        StateHasChanged();
    }

    private void ResetModalForm()
    {
        reviewerName = "";
        reviewTitle = "";
        reviewComment = "";
        selectedRating = 5;
        hoverRating = 0;
        submissionSuccess = false;
        errorMessage = "";
    }

    private void SetRating(int rating) => selectedRating = rating;
    private void SetHoverRating(int rating) => hoverRating = rating;
    private void ClearHoverRating() => hoverRating = 0;

    private string EffectiveScoreText
    {
        get
        {
            int r = hoverRating > 0 ? hoverRating : selectedRating;
            return r switch
            {
                5 => "5.0 - Exceptional Care",
                4 => "4.0 - Very Good Care",
                3 => "3.0 - Satisfactory Care",
                2 => "2.0 - Needs Improvement",
                _ => "1.0 - Poor Experience"
            };
        }
    }

    private async Task HandleModalSubmit()
    {
        if (string.IsNullOrWhiteSpace(reviewerName) || 
            string.IsNullOrWhiteSpace(reviewTitle) || 
            string.IsNullOrWhiteSpace(reviewComment))
        {
            errorMessage = "Please complete all fields before submitting.";
            return;
        }

        string initials = "PT";
        var parts = reviewerName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initials = $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        else if (parts.Length == 1 && parts[0].Length >= 2)
        {
            initials = parts[0].Substring(0, 2).ToUpper();
        }

        string serviceLabel = selectedService switch
        {
            "Home Visits" => "Home Doctor Visit",
            "Prescriptions" => "Doorstep Prescriptions",
            "Diagnostics" => "At-Home Lab Diagnostics",
            _ => "Urgent Telehealth"
        };

        var newReview = new ReviewItem
        {
            Author = reviewerName.Trim(),
            Role = $"{serviceLabel} Patient",
            Initials = initials,
            AvatarUrl = "",
            Title = reviewTitle.Trim(),
            Quote = reviewComment.Trim(),
            Service = serviceLabel,
            Category = selectedService,
            Badge = "Verified Patient",
            Rating = selectedRating,
            TimeAgo = "Just now"
        };

        if (CustomReviews != null)
        {
            CustomReviews.Insert(0, newReview);
        }
        else
        {
            defaultReviews.Insert(0, newReview);
        }

        if (OnReviewAdded.HasDelegate)
        {
            await OnReviewAdded.InvokeAsync(newReview);
        }

        selectedCategory = "All Reviews";
        activeIndex = 0;
        submissionSuccess = true;
        errorMessage = "";
    }

    private string GetCard3DStyle(int offset)
    {
        // Active Center Card
        if (offset == 0)
        {
            return "transform: translateX(0px) translateZ(80px) rotateY(0deg) scale(1.04); z-index: 30; opacity: 1; cursor: default;";
        }
        
        // Immediate Right (+1)
        if (offset == 1)
        {
            return "transform: translateX(250px) translateZ(-30px) rotateY(-20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        }
        
        // Immediate Left (-1)
        if (offset == -1)
        {
            return "transform: translateX(-250px) translateZ(-30px) rotateY(20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        }
        
        // Outer Right (+2)
        if (offset == 2)
        {
            return "transform: translateX(470px) translateZ(-80px) rotateY(-28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";
        }
        
        // Outer Left (-2)
        if (offset == -2)
        {
            return "transform: translateX(-470px) translateZ(-80px) rotateY(28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";
        }

        // Hidden beyond (+3, -3, etc.)
        int direction = offset > 0 ? 1 : -1;
        int distance = direction * 660;
        int angle = direction * -35;
        return $"transform: translateX({distance}px) translateZ(-120px) rotateY({angle}deg) scale(0.65); z-index: 0; opacity: 0; pointer-events: none;";
    }

