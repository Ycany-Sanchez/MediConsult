@rendermode InteractiveServer

<style>
    /* RevealStagger reduced-motion fallback (Section 5.C + 6.B) */
    @@media (prefers-reduced-motion: reduce) {
        .reveal-on-scroll,
        .reveal-fade,
        .reveal-scale {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
        .accordion-body-enter {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>

<div class="w-full">
    <!-- Header (vertical stack, single eyebrow) -->
    <div class="max-w-3xl mb-10 sm:mb-14 reveal-on-scroll">
        <div class="flex items-center space-x-3 mb-4">
            <a href="/"
               class="inline-flex items-center space-x-2 text-xs font-semibold text-neutral-700 hover:text-black bg-neutral-100 hover:bg-neutral-200/90 px-3.5 py-1.5 rounded-full transition-all duration-200 ease-spring group border border-neutral-200/70">
                <!-- Tabler arrow-left, stroke 2 -->
                <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-200 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to landing page</span>
            </a>
            <span class="inline-block px-3.5 py-1.5 rounded-lg bg-brand-lime text-xs font-bold text-neutral-900 uppercase tracking-wider">
                How It Works
            </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-900 leading-tight">
            Complete care, step by step.
        </h1>
        <p class="text-neutral-600 text-sm sm:text-base mt-2.5 leading-relaxed">
            Select any step on the right to preview its live portal screen on the left.
        </p>
    </div>

    <!-- Main Grid: Landscape Screen (Left) + Steps Dropdown Boxes (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- Left Column: Landscape Screen (lg:col-span-7) -->
        <div class="lg:col-span-7 lg:sticky lg:top-28 w-full reveal-on-scroll delay-100">
            <div class="w-full bg-neutral-100/80 rounded-3xl p-3 sm:p-4 border border-neutral-200/90">
                <!-- Browser Chrome Top Bar -->
                <div class="bg-white rounded-t-2xl px-4 py-2.5 border-b border-neutral-200 flex items-center justify-between gap-3">
                    <div class="flex items-center space-x-1.5" aria-hidden="true">
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                    </div>

                    <div class="flex items-center space-x-2 bg-neutral-50 px-3 py-1 rounded-full text-xs text-neutral-600 font-mono border border-neutral-200 max-w-xs truncate">
                        <!-- Tabler lock, stroke 2 -->
                        <svg class="w-3 h-3 text-emerald-700 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="truncate">mediconsult.health/portal/@CurrentUrlPath</span>
                    </div>

                    <!-- Step Pill: verb noun label, single hyphen separator -->
                    <div class="flex items-center text-[11px] font-semibold text-neutral-900 bg-brand-lime/25 border border-brand-lime/50 px-2.5 py-0.5 rounded-full whitespace-nowrap">
                        <span>@ActiveVerbLabel - @activeStep of 6</span>
                    </div>
                </div>

                <!-- Landscape Screen Canvas -->
                <div class="bg-white rounded-b-2xl p-5 sm:p-7 h-[360px] sm:h-[400px] flex flex-col justify-between overflow-hidden">
                    @switch (activeStep)
                    {
                        case 1:
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Complete Intake</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Patient Intake Summary</h3>
                                        <p class="text-xs text-neutral-600 mt-0.5">Jane Reyes</p>
                                        <p class="text-xs text-neutral-600 mt-0.5">Verified ID MC-7729</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
                                        Verified Secure
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-3.5">
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200/80">
                                        <p class="text-[11px] font-medium text-neutral-600">Reported symptoms</p>
                                        <p class="text-sm font-bold text-neutral-900 mt-1">Sinus Pressure and Fever</p>
                                        <p class="text-[11px] text-neutral-600 mt-0.5">Duration 3 consecutive days</p>
                                    </div>
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200/80">
                                        <p class="text-[11px] font-medium text-neutral-600">Known allergies</p>
                                        <p class="text-sm font-bold text-neutral-900 mt-1">Penicillin (Mild Rash)</p>
                                        <p class="text-[11px] text-neutral-600 mt-0.5">Imported from verified EHR record</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-brand-lime/15 border border-brand-lime/30 flex items-center justify-between gap-3">
                                    <div class="flex items-center space-x-2.5">
                                        <span class="w-6 h-6 rounded-full bg-brand-lime flex items-center justify-center flex-shrink-0" aria-hidden="true">
                                            <!-- Tabler check, stroke 2 -->
                                            <svg class="w-3.5 h-3.5 text-neutral-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </span>
                                        <div>
                                            <p class="text-xs font-bold text-neutral-900">Pre-Consultation Intake 100 Percent Complete</p>
                                            <p class="text-[11px] text-neutral-600">Clinical profile ready for physician matching</p>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-neutral-900 whitespace-nowrap">Ready</span>
                                </div>
                            </div>
                            break;

                        case 2:
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Match Specialist</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Matched Specialist</h3>
                                        <p class="text-xs text-neutral-600 mt-0.5">Physician available for immediate consultation</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-900 whitespace-nowrap">
                                        Immediate Slot
                                    </span>
                                </div>

                                <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between gap-3">
                                    <div class="flex items-center space-x-3.5">
                                        <div class="w-12 h-12 rounded-xl bg-brand-dark text-white flex items-center justify-center font-bold text-sm flex-shrink-0">
                                            SB
                                        </div>
                                        <div>
                                            <div class="flex items-center space-x-2">
                                                <h4 class="text-sm sm:text-base font-bold text-neutral-900">Dr. Sarah Bennett, MD</h4>
                                                <span class="inline-flex items-center space-x-1 text-xs font-bold text-neutral-900">
                                                    <!-- Tabler star, stroke 2 -->
                                                    <svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                    <span>4.98</span>
                                                </span>
                                            </div>
                                            <p class="text-xs text-neutral-600">Chief of Internal Medicine</p>
                                            <p class="text-xs text-neutral-600">Johns Hopkins Fellow</p>
                                            <p class="text-[11px] text-emerald-700 font-medium mt-0.5">Next slot opening within 8 minutes</p>
                                        </div>
                                    </div>
                                    <span class="px-3 py-1.5 rounded-lg bg-brand-dark text-white text-xs font-semibold whitespace-nowrap">
                                        Selected
                                    </span>
                                </div>

                                <div class="grid grid-cols-3 gap-3 text-center text-xs">
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-neutral-900">1,420 plus</p>
                                        <p class="text-[10px] text-neutral-600">Consultations</p>
                                    </div>
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-neutral-900">12 Years</p>
                                        <p class="text-[10px] text-neutral-600">Experience</p>
                                    </div>
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-emerald-700">Zero Wait</p>
                                        <p class="text-[10px] text-neutral-600">Direct Entry</p>
                                    </div>
                                </div>
                            </div>
                            break;

                        case 3:
                            <div class="space-y-3 accordion-body-enter">
                                <div class="flex items-start justify-between pb-2 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Start Video Visit</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Live Consultation Room</h3>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
                                        1080p HD
                                    </span>
                                </div>

                                <div class="w-full rounded-xl bg-neutral-100 overflow-hidden border border-neutral-200">
                                    <img src="images/consultation.png"
                                         alt="Doctor video consult"
                                         class="w-full h-44 sm:h-48 object-cover" />
                                </div>
                                <p class="text-[11px] text-neutral-600">Dr. Sarah Bennett, MD shown in live visit view.</p>

                                <div class="flex items-center justify-between gap-2 text-xs text-neutral-600">
                                    <span class="inline-flex items-center space-x-1">
                                        <!-- Tabler clock, stroke 2 -->
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>00:14:28 elapsed</span>
                                    </span>
                                    <span class="inline-flex items-center space-x-3">
                                        <span class="inline-flex items-center space-x-1">
                                            <!-- Tabler mic, stroke 2 -->
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                                <line x1="12" y1="19" x2="12" y2="23"></line>
                                            </svg>
                                            <span>Audio Clear</span>
                                        </span>
                                        <span class="inline-flex items-center space-x-1">
                                            <!-- Tabler video, stroke 2 -->
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                            </svg>
                                            <span>1080p WebRTC</span>
                                        </span>
                                        <span class="inline-flex items-center space-x-1">
                                            <!-- Tabler shield, stroke 2 -->
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            </svg>
                                            <span>256-Bit TLS Vault</span>
                                        </span>
                                    </span>
                                </div>
                            </div>
                            break;

                        case 4:
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Get Prescription</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Digital Prescription</h3>
                                        <p class="text-xs text-neutral-600 mt-0.5">Order MC-98214 signed by Dr. Bennett</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-900 whitespace-nowrap">
                                        Dispatched
                                    </span>
                                </div>

                                <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200/80 space-y-1.5">
                                    <div class="flex items-center justify-between gap-3">
                                        <span class="text-sm font-bold text-neutral-900">Amoxicillin 500mg Oral Capsule</span>
                                        <span class="text-xs font-mono text-neutral-600 whitespace-nowrap">30 Capsules</span>
                                    </div>
                                    <p class="text-xs text-neutral-600 leading-relaxed">
                                        Take 1 capsule orally every 8 hours with meals for 10 days until finished.
                                    </p>
                                </div>

                                <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs gap-3">
                                    <div>
                                        <p class="font-bold text-neutral-900">Doorstep Courier Delivery</p>
                                        <p class="text-[11px] text-neutral-600">Dispatched directly to home address</p>
                                    </div>
                                    <span class="font-bold text-emerald-700 whitespace-nowrap">Arriving in 42 mins</span>
                                </div>
                            </div>
                            break;

                        case 5:
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Book Labs</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">At-Home Diagnostics</h3>
                                        <p class="text-xs text-neutral-600 mt-0.5">Order LAB-4029</p>
                                        <p class="text-xs text-neutral-600 mt-0.5">Certified mobile phlebotomist</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
                                        Scheduled
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-3.5">
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <p class="text-[11px] font-medium text-neutral-600">Ordered panels</p>
                                        <p class="text-xs font-bold text-neutral-900 mt-1">Comprehensive Metabolic (CMP)</p>
                                        <p class="text-[11px] text-neutral-600 mt-0.5">Plus Complete Blood Count (CBC)</p>
                                    </div>
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <p class="text-[11px] font-medium text-neutral-600">Turnaround time</p>
                                        <p class="text-xs font-bold text-neutral-900 mt-1">24-Hour Digital Results</p>
                                        <p class="text-[11px] text-neutral-600 mt-0.5">Uploaded directly to your portal</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs gap-3">
                                    <div>
                                        <p class="font-bold text-neutral-900">Home Collection Window</p>
                                        <p class="text-[11px] text-neutral-600">Phlebotomist arrival window</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-bold text-neutral-900 whitespace-nowrap">Today</p>
                                        <p class="font-medium text-neutral-600 whitespace-nowrap">2:00 PM - 3:00 PM</p>
                                    </div>
                                </div>
                            </div>
                            break;

                        case 6:
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100 gap-3">
                                    <div>
                                        <p class="text-xs font-semibold text-neutral-600">Sync Vitals</p>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Continuous Health Tracking</h3>
                                        <p class="text-xs text-neutral-600 mt-0.5">Wearables synced from Apple Health</p>
                                        <p class="text-xs text-neutral-600 mt-0.5">Plus Withings devices</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-900 whitespace-nowrap">
                                        Live Sync
                                    </span>
                                </div>

                                <div class="grid grid-cols-3 gap-3 text-center">
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <p class="text-[10px] text-neutral-600 font-medium">Heart Rate</p>
                                        <p class="text-base font-bold text-neutral-900 mt-1">72 <span class="text-[10px] font-normal text-neutral-600">bpm</span></p>
                                        <p class="text-[11px] font-semibold text-emerald-700">Normal</p>
                                    </div>
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <p class="text-[10px] text-neutral-600 font-medium">Blood Pressure</p>
                                        <p class="text-base font-bold text-neutral-900 mt-1">118/76</p>
                                        <p class="text-[11px] font-semibold text-emerald-700">Optimal</p>
                                    </div>
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <p class="text-[10px] text-neutral-600 font-medium">Oxygen</p>
                                        <p class="text-base font-bold text-neutral-900 mt-1">99 percent</p>
                                        <p class="text-[11px] font-semibold text-emerald-700">Calibrated</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs gap-3">
                                    <div>
                                        <p class="font-bold text-neutral-900">24/7 Care Team Messaging</p>
                                        <p class="text-[11px] text-neutral-600">Follow-up check completed by Dr. Bennett</p>
                                    </div>
                                    <span class="font-bold text-emerald-700 whitespace-nowrap">Active</span>
                                </div>
                            </div>
                            break;
                    }

                    <!-- Screen Bottom Footer Status -->
                    <div class="pt-3 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-600 gap-3">
                        <span>MediConsult Clinical OS</span>
                        <span class="font-medium text-neutral-900">Live preview - @ActiveVerbLabel</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Steps as Dropdown Boxes (lg:col-span-5) -->
        <div class="lg:col-span-5 w-full reveal-on-scroll delay-150">
            <div class="flex items-center justify-between pb-2 border-b border-neutral-200">
                <h2 class="text-sm font-bold text-neutral-900">Care walkthrough</h2>
                <span class="text-xs font-medium text-neutral-600">6 steps</span>
            </div>

            <div class="space-y-3 mt-3">
                @for (int idx = 0; idx < steps.Count; idx++)
                {
                    var step = steps[idx];
                    var isSelected = activeStep == step.Id;
                    var staggerDelay = idx * 60;
                    <div class="reveal-on-scroll rounded-2xl border transition-all duration-300 @(isSelected ? "border-neutral-900 bg-white shadow-md ring-1 ring-neutral-900/10" : "border-neutral-200 bg-neutral-50/60 hover:bg-neutral-50 hover:border-neutral-300")" style="transition-delay:@(staggerDelay)ms">
                        <button type="button"
                                @onclick="() => ToggleStep(step.Id)"
                                aria-expanded="@isSelected"
                                class="w-full p-4 flex items-center justify-between text-left focus:outline-none transition-colors select-none">

                            <div class="flex items-center space-x-3.5">
                                <span class="w-7 h-7 rounded-lg flex items-center justify-center transition-colors flex-shrink-0 @(isSelected ? "bg-brand-lime text-neutral-900" : "bg-neutral-200 text-neutral-700")" aria-hidden="true">
                                    @if (step.Id == 1)
                                    {
                                        <!-- Tabler clipboard, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="8" y="2" width="8" height="4" rx="1"></rect>
                                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                                            <path d="M9 12h6"></path>
                                            <path d="M9 16h6"></path>
                                        </svg>
                                    }
                                    else if (step.Id == 2)
                                    {
                                        <!-- Tabler user-check, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                            <polyline points="16 11 18 13 22 9"></polyline>
                                        </svg>
                                    }
                                    else if (step.Id == 3)
                                    {
                                        <!-- Tabler video, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                        </svg>
                                    }
                                    else if (step.Id == 4)
                                    {
                                        <!-- Tabler pill, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path>
                                            <path d="m8.5 8.5 7 7"></path>
                                        </svg>
                                    }
                                    else if (step.Id == 5)
                                    {
                                        <!-- Tabler flask, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M9 3h6"></path>
                                            <path d="M10 3v5L4.5 18a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 8V3"></path>
                                            <path d="M7.5 13h9"></path>
                                        </svg>
                                    }
                                    else
                                    {
                                        <!-- Tabler activity, stroke 2 -->
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                                        </svg>
                                    }
                                </span>
                                <div>
                                    <h3 class="text-sm sm:text-base font-bold text-neutral-900 leading-snug">
                                        @step.VerbLabel
                                    </h3>
                                    <span class="text-[11px] text-neutral-600 font-medium">
                                        @step.Subtitle
                                    </span>
                                </div>
                            </div>

                            <div class="w-7 h-7 rounded-full flex items-center justify-center text-neutral-600 transition-transform duration-300 flex-shrink-0 @(isSelected ? "rotate-180 text-neutral-900 bg-neutral-100" : "")" aria-hidden="true">
                                <!-- Tabler chevron-down, stroke 2 -->
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </div>
                        </button>

                        @if (isSelected)
                        {
                            <div class="px-5 pb-4 pt-1 border-t border-neutral-100 accordion-body-enter">
                                <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                                    @step.Description
                                </p>

                                <div class="mt-3 flex items-center justify-between text-xs pt-2 border-t border-neutral-100/80 gap-3">
                                    <span class="text-neutral-600 font-medium inline-flex items-center space-x-1.5">
                                        <!-- Tabler clock, stroke 2 -->
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>@step.Duration</span>
                                    </span>
                                    <span class="text-neutral-900 font-semibold text-[11px] inline-flex items-center space-x-1">
                                        <!-- Tabler arrow-left, stroke 2 -->
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <line x1="19" y1="12" x2="5" y2="12"></line>
                                            <polyline points="12 19 5 12 12 5"></polyline>
                                        </svg>
                                        <span>Showing on left preview</span>
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Bottom CTA Row: single signup intent -->
            <div class="pt-5 flex flex-wrap items-center gap-4 reveal-on-scroll delay-200">
                <a href="/signup" class="motion-btn motion-btn-dark px-7 py-3.5 rounded-full bg-brand-dark text-white text-xs font-semibold hover:bg-neutral-800 transition whitespace-nowrap">
                    Start Care Plan
                </a>
                <span class="text-xs text-neutral-600">
                    Average intake completion under 2 minutes
                </span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int InitialStep { get; set; } = 1;

    private int activeStep = 1;

    protected override void OnInitialized()
    {
        activeStep = InitialStep;
    }

    private void ToggleStep(int id)
    {
        activeStep = id;
    }

    private string ActiveVerbLabel => steps.FirstOrDefault(s => s.Id == activeStep)?.VerbLabel ?? "Care walkthrough";

    private string CurrentUrlPath => activeStep switch
    {
        1 => "intake/medical-history",
        2 => "specialists/matching",
        3 => "consultation/live-video",
        4 => "prescriptions/orders",
        5 => "diagnostics/lab-kits",
        6 => "telemetry/vitals-stream",
        _ => "dashboard"
    };

    private record StepItem(int Id, string VerbLabel, string Subtitle, string Description, string Duration);

    private List<StepItem> steps = new()
    {
        new(
            1,
            "Complete Intake",
            "Encrypted 2 minute clinical intake",
            "Fill out your baseline medical history, current symptoms, allergies, and verify your ID securely without paper forms.",
            "2 mins setup"
        ),
        new(
            2,
            "Match Specialist",
            "Filter 30 plus board certified fields",
            "Browse through 30 plus medical specialties. Filter certified physicians by clinical focus, language, and immediate slot availability.",
            "Immediate access"
        ),
        new(
            3,
            "Start Video Visit",
            "Zero latency browser video call",
            "Connect directly with your doctor via encrypted, high-definition video in your browser with no app downloads required.",
            "Zero waiting room"
        ),
        new(
            4,
            "Get Prescription",
            "Digital e-Rx dispatched in minutes",
            "Prescriptions are signed instantly and routed electronically to your preferred local pharmacy or dispatched for same-day delivery.",
            "Same-day courier"
        ),
        new(
            5,
            "Book Labs",
            "Phlebotomy and 24 hr lab turnaround",
            "When laboratory diagnostics are needed, certified phlebotomists collect samples at your home with digital results in 24 hours.",
            "24 hr results"
        ),
        new(
            6,
            "Sync Vitals",
            "Telemetry sync and 24/7 care messaging",
            "Sync wearable health metrics, review doctor encounter summaries, and message your dedicated care team anytime 24/7.",
            "Continuous care"
        )
    };
}
