@page "/reviews"
@rendermode InteractiveServer

<PageTitle>Patient Reviews &amp; Ratings - MediConsult</PageTitle>

<div class="min-h-screen bg-white text-neutral-900 font-sans selection:bg-brand-lime selection:text-black flex flex-col justify-between">
    <Navbar />

    <main class="max-w-7xl mx-auto w-full px-6 pt-8 sm:pt-12 pb-20 flex-grow">
        <!-- Top Back Nav & Eyebrow -->
        <div class="flex items-center space-x-3 mb-6 reveal-on-scroll">
            <a href="/" 
               class="inline-flex items-center space-x-2 text-xs font-semibold text-neutral-700 hover:text-black bg-neutral-100 hover:bg-neutral-200/90 px-3.5 py-1.5 rounded-full transition-all duration-200 ease-spring group border border-neutral-200/70 shadow-2xs">
                <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-200 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to Home</span>
            </a>
            <span class="inline-block px-3.5 py-1.5 rounded-lg bg-brand-lime text-xs font-bold text-neutral-900 uppercase tracking-wider shadow-sm">
                Patient Feedback
            </span>
        </div>

        <!-- Section Heading (Vertical Stack per Section 4.7) -->
        <div class="max-w-3xl mb-10 reveal-on-scroll delay-100">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-900 leading-tight">
                Patient Reviews &amp; Ratings
            </h1>
            <p class="text-neutral-600 text-base sm:text-lg mt-3 leading-relaxed max-w-2xl">
                Verified patient feedback, clinical scores, and real experiences from consultations across all 50 states.
            </p>
        </div>

        <!-- Aggregate Score Bento Strip -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-12 reveal-on-scroll delay-150">
            <!-- Overall Rating Tile -->
            <div class="md:col-span-4 bg-brand-dark text-white rounded-3xl p-8 flex flex-col justify-between shadow-xl relative overflow-hidden group">
                <div class="absolute -right-12 -bottom-12 w-44 h-44 rounded-full bg-brand-lime/10 blur-2xl pointer-events-none"></div>
                <div>
                    <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider">Overall Satisfaction</span>
                    <div class="flex items-baseline space-x-3 mt-4">
                        <span class="text-5xl sm:text-6xl font-extrabold text-white tracking-tight">4.9</span>
                        <div class="space-y-1">
                            <div class="flex items-center space-x-1">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <svg class="w-4 h-4 fill-brand-lime text-brand-lime" viewBox="0 0 24 24">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                }
                            </div>
                            <p class="text-xs text-neutral-400">Out of 5.0 rating</p>
                        </div>
                    </div>
                </div>
                <div class="pt-6 border-t border-neutral-800 text-xs text-neutral-400 flex items-center justify-between">
                    <span>52,480+ verified consults</span>
                    <span class="text-brand-lime font-semibold">98.6% recommended</span>
                </div>
            </div>

            <!-- Score Breakdown Tile -->
            <div class="md:col-span-5 bg-[#F8F9FA] rounded-3xl p-8 border border-neutral-200/90 shadow-sm flex flex-col justify-between">
                <div>
                    <h3 class="text-xs font-bold text-neutral-500 uppercase tracking-wider mb-4">Rating Distribution</h3>
                    <div class="space-y-2.5">
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="w-12 font-medium text-neutral-700">5 stars</span>
                            <div class="flex-grow bg-neutral-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-dark h-full rounded-full" style="width: 94%;"></div>
                            </div>
                            <span class="w-8 text-right font-bold text-neutral-900">94%</span>
                        </div>
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="w-12 font-medium text-neutral-700">4 stars</span>
                            <div class="flex-grow bg-neutral-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-dark/70 h-full rounded-full" style="width: 5%;"></div>
                            </div>
                            <span class="w-8 text-right font-bold text-neutral-900">5%</span>
                        </div>
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="w-12 font-medium text-neutral-700">3 stars</span>
                            <div class="flex-grow bg-neutral-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-dark/40 h-full rounded-full" style="width: 1%;"></div>
                            </div>
                            <span class="w-8 text-right font-bold text-neutral-900">1%</span>
                        </div>
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="w-12 font-medium text-neutral-700">2 stars</span>
                            <div class="flex-grow bg-neutral-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-dark/20 h-full rounded-full" style="width: 0%;"></div>
                            </div>
                            <span class="w-8 text-right font-bold text-neutral-900">0%</span>
                        </div>
                        <div class="flex items-center space-x-3 text-xs">
                            <span class="w-12 font-medium text-neutral-700">1 star</span>
                            <div class="flex-grow bg-neutral-200 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-dark/20 h-full rounded-full" style="width: 0%;"></div>
                            </div>
                            <span class="w-8 text-right font-bold text-neutral-900">0%</span>
                        </div>
                    </div>
                </div>
                <p class="text-[11px] text-neutral-500 pt-4 mt-2 border-t border-neutral-200/80">
                    Compiled directly from post-consultation digital verification surveys.
                </p>
            </div>

            <!-- Trust Highlights Tile -->
            <div class="md:col-span-3 bg-brand-lime text-neutral-950 rounded-3xl p-8 flex flex-col justify-between shadow-md group">
                <div>
                    <span class="text-xs font-bold text-neutral-900/70 uppercase tracking-wider">Clinical Standards</span>
                    <h3 class="text-xl font-bold mt-2 text-neutral-950">100% Verified Consultations</h3>
                    <p class="text-xs text-neutral-900/80 mt-2 leading-relaxed">
                        Every review is matched against a verified physician appointment or prescription delivery.
                    </p>
                </div>
                <div class="pt-4 border-t border-black/10 flex items-center space-x-2 text-xs font-bold text-neutral-950">
                    <svg class="w-4 h-4 text-neutral-950 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span>HIPAA Data Governance</span>
                </div>
            </div>
        </div>

        <!-- 3D Coverflow Showcase (Matching Reference Image) -->
        <div class="mb-16 reveal-on-scroll delay-200">
            <StaggeredTestimonials CustomReviews="activeReviews" />
        </div>

        <!-- Review Submission Form Section -->
        <div class="max-w-3xl mx-auto reveal-on-scroll delay-250">
            <div class="bg-[#F8F9FA] rounded-3xl p-8 sm:p-10 border border-neutral-200/90 shadow-sm">
                <div class="mb-8 text-center max-w-lg mx-auto">
                    <span class="inline-block px-3 py-1 rounded-lg bg-neutral-200 text-neutral-800 text-xs font-bold uppercase tracking-wider mb-2">
                        Share Your Story
                    </span>
                    <h2 class="text-3xl font-bold tracking-tight text-neutral-900">Rate Your Experience</h2>
                    <p class="text-neutral-500 text-sm mt-1.5 leading-relaxed">
                        Help fellow patients choose the right care provider. All reviews are cross-referenced with verified consultation records.
                    </p>
                </div>

                @if (submissionSuccess)
                {
                    <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 mb-8 text-neutral-900">
                        <div class="flex items-center space-x-2.5 text-emerald-800 font-bold text-base mb-1">
                            <svg class="w-5 h-5 text-emerald-600 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Review Submitted and Verified!</span>
                        </div>
                        <p class="text-xs sm:text-sm text-emerald-700 leading-relaxed">
                            Thank you for your feedback. Your review has been added to our verified patient registry and is now live on the showcase above.
                        </p>
                        <button type="button" 
                                @onclick="ResetForm" 
                                class="mt-4 inline-flex items-center space-x-1.5 text-xs font-bold text-neutral-900 underline hover:text-neutral-700">
                            <span>Submit another review</span>
                            <span>&rarr;</span>
                        </button>
                    </div>
                }

                <form @onsubmit="HandleReviewSubmit" class="space-y-6">
                    <!-- 1. Interactive Star Rating Selector -->
                    <div>
                        <label class="block text-xs font-semibold text-neutral-800 mb-2">
                            Select Consultation Rating
                        </label>
                        
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 bg-white rounded-2xl border border-neutral-200 shadow-2xs">
                            <div class="flex items-center space-x-1.5" @onmouseout="ClearHoverRating">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    var starIndex = s;
                                    var isFilled = (hoverRating > 0 ? starIndex <= hoverRating : starIndex <= selectedRating);

                                    <button type="button"
                                            @onclick="() => SetRating(starIndex)"
                                            @onmouseover="() => SetHoverRating(starIndex)"
                                            class="star-btn p-1 focus:outline-none focus:ring-2 focus:ring-neutral-900 rounded-lg text-neutral-300"
                                            aria-label="Rate @starIndex stars out of 5">
                                        @if (isFilled)
                                        {
                                            <svg class="w-8 h-8 fill-amber-400 text-amber-400 transition-colors duration-150" viewBox="0 0 24 24">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-8 h-8 fill-neutral-200 text-neutral-200 transition-colors duration-150" viewBox="0 0 24 24">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                        }
                                    </button>
                                }
                            </div>
                            
                            <span class="text-xs font-bold text-neutral-900 bg-neutral-100 px-3 py-1.5 rounded-xl border border-neutral-200 self-start sm:self-auto">
                                @EffectiveScoreText
                            </span>
                        </div>

                        <p class="text-xs text-neutral-500 mt-2 font-medium">
                            @GetRatingDescription(hoverRating > 0 ? hoverRating : selectedRating)
                        </p>
                    </div>

                    <!-- 2-Column Row: Name & Service -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <!-- Full Name -->
                        <div>
                            <label for="reviewerName" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Full Name
                            </label>
                            <input id="reviewerName" 
                                   type="text" 
                                   required 
                                   @bind="reviewerName"
                                   placeholder="e.g. Julian Hayes" 
                                   class="w-full px-4 py-3 rounded-xl border border-neutral-300 bg-white text-sm text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition" />
                            <span class="block text-[11px] text-neutral-500 mt-1">
                                Will be displayed with your verified patient badge.
                            </span>
                        </div>

                        <!-- Service Category -->
                        <div>
                            <label for="serviceCategory" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                                Consultation Service
                            </label>
                            <select id="serviceCategory" 
                                    @bind="selectedService"
                                    class="w-full px-4 py-3 rounded-xl border border-neutral-300 bg-white text-sm text-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition">
                                <option value="Video Telehealth">Video Telehealth Consultation</option>
                                <option value="Home Visits">Home Doctor Visit</option>
                                <option value="Prescriptions">Doorstep Prescription Delivery</option>
                                <option value="Diagnostics">At-Home Lab Diagnostics</option>
                            </select>
                        </div>
                    </div>

                    <!-- Review Headline -->
                    <div>
                        <label for="reviewTitle" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                            Review Headline
                        </label>
                        <input id="reviewTitle" 
                               type="text" 
                               required 
                               @bind="reviewTitle"
                               placeholder="e.g. Prompt, compassionate, and precise care" 
                               class="w-full px-4 py-3 rounded-xl border border-neutral-300 bg-white text-sm text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition" />
                    </div>

                    <!-- Review Comments Textarea -->
                    <div>
                        <label for="reviewComment" class="block text-xs font-semibold text-neutral-800 mb-1.5">
                            Your Consultation Experience
                        </label>
                        <textarea id="reviewComment" 
                                  rows="3" 
                                  required 
                                  @bind="reviewComment"
                                  placeholder="Describe details about the physician's communication, turnaround time, or treatment outcome..."
                                  class="w-full px-4 py-3 rounded-xl border border-neutral-300 bg-white text-sm text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition resize-none"></textarea>
                        <span class="block text-[11px] text-neutral-500 mt-1">
                            Keep feedback focused and concise (2 to 3 sentences recommended).
                        </span>
                    </div>

                    <!-- Error Alert -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 font-medium">
                            @errorMessage
                        </div>
                    }

                    <!-- Submit Button -->
                    <button type="submit" 
                            class="motion-btn motion-btn-dark w-full py-4 rounded-full bg-brand-dark text-white text-sm font-semibold hover:bg-black transition duration-200 shadow-md flex items-center justify-center space-x-2">
                        <span>Submit Patient Review</span>
                        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                    <p class="text-center text-[11px] text-neutral-400 pt-1">
                        Zero spam policy &middot; HIPAA compliant feedback privacy
                    </p>
                </form>
            </div>
        </div>
    </main>

    <CtaBanner />
    <Footer />
</div>

@code {
    private int selectedRating = 5;
    private int hoverRating = 0;
    private string reviewerName = "";
    private string selectedService = "Video Telehealth";
    private string reviewTitle = "";
    private string reviewComment = "";
    private string errorMessage = "";
    private bool submissionSuccess = false;

    private List<StaggeredTestimonials.ReviewItem> activeReviews = new()
    {
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Pete Gallagher",
            Role = "Director of Operations, Corporate Wellness",
            Initials = "PG",
            AvatarUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80",
            Title = "Found the right solution",
            Quote = "I have been searching for a telehealth service like MediConsult for years. Direct physician video in minutes and zero pharmacy wait times.",
            Service = "Urgent Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "2 days ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Andy Kovacs",
            Role = "DevOps Engineer, Cloud Systems",
            Initials = "AK",
            AvatarUrl = "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80",
            Title = "Switched and never looked back",
            Quote = "I switched our household prescriptions to MediConsult two years ago and never looked back. Same-day refills delivered straight to our front porch.",
            Service = "Doorstep Prescriptions",
            Category = "Prescriptions",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "4 days ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Dr. Clara Morales",
            Role = "Physician & Family Caregiver",
            Initials = "CM",
            AvatarUrl = "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80",
            Title = "Exceptional clinical rigor",
            Quote = "The board-certified home visit doctor arrived on time with comprehensive diagnostic gear. Thorough vitals check and zero waiting room exposure for my father.",
            Service = "Home Doctor Visit",
            Category = "Home Visits",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 week ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Olivia Campbell",
            Role = "Client Success Lead, HealthTech",
            Initials = "OC",
            AvatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80",
            Title = "Customer care is unparalleled",
            Quote = "The consultation was simple, intuitive, and immediate. The attending physician listened carefully and resolved my prescription in under ten minutes.",
            Service = "Urgent Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "2 weeks ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Marina Silva",
            Role = "People Operations Partner",
            Initials = "MS",
            AvatarUrl = "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80",
            Title = "Fast diagnostic turnaround",
            Quote = "The phlebotomist arrived punctually at 7:30 AM before my workday started. Lab results posted to my patient dashboard before dinner the same day.",
            Service = "At-Home Lab Diagnostics",
            Category = "Diagnostics",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "3 weeks ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "David Chen",
            Role = "Senior Data Analyst",
            Initials = "DC",
            AvatarUrl = "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=150&auto=format&fit=crop&q=80",
            Title = "Continuous vitals monitoring",
            Quote = "Connected my blood pressure monitor directly into the portal. Dr. Reynolds reviewed my monthly trends and adjusted my dosage with zero friction.",
            Service = "Cardiology Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 month ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Angela Brooks",
            Role = "Educator & Parent",
            Initials = "AB",
            AvatarUrl = "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80",
            Title = "Saved our family an ER trip",
            Quote = "Having a board-certified pediatrician available at 10 PM on a Sunday saved us a stressful emergency room trip. Calm, empathetic, and exceptionally professional.",
            Service = "Pediatric Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 month ago"
        }
    };

    private string EffectiveScoreText => $"{(hoverRating > 0 ? hoverRating : selectedRating)}.0 / 5.0";

    private void SetRating(int rating)
    {
        selectedRating = rating;
    }

    private void SetHoverRating(int rating)
    {
        hoverRating = rating;
    }

    private void ClearHoverRating()
    {
        hoverRating = 0;
    }

    private string GetRatingDescription(int rating)
    {
        return rating switch
        {
            5 => "5.0 out of 5: Exceptional clinical care and speed",
            4 => "4.0 out of 5: Very good consultation experience",
            3 => "3.0 out of 5: Satisfactory clinical care",
            2 => "2.0 out of 5: Below expectations",
            1 => "1.0 out of 5: Unsatisfactory service",
            _ => "Select star score to rate"
        };
    }

    private void HandleReviewSubmit()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(reviewerName) || string.IsNullOrWhiteSpace(reviewComment))
        {
            errorMessage = "Please provide your full name and consultation comments.";
            return;
        }

        string initials = "PT";
        var parts = reviewerName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initials = $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        else if (parts.Length == 1 && parts[0].Length >= 2)
        {
            initials = parts[0].Substring(0, 2).ToUpper();
        }

        string serviceLabel = selectedService switch
        {
            "Home Visits" => "Home Doctor Visit",
            "Prescriptions" => "Doorstep Prescriptions",
            "Diagnostics" => "At-Home Lab Diagnostics",
            _ => "Urgent Telehealth"
        };

        var newReview = new StaggeredTestimonials.ReviewItem
        {
            Author = reviewerName.Trim(),
            Role = $"{serviceLabel} Patient",
            Initials = initials,
            AvatarUrl = "",
            Title = string.IsNullOrWhiteSpace(reviewTitle) ? "Verified Patient Feedback" : reviewTitle.Trim(),
            Quote = reviewComment.Trim(),
            Service = serviceLabel,
            Category = selectedService,
            Badge = "Verified Patient",
            Rating = selectedRating,
            TimeAgo = "Just now"
        };

        // Prepend to active list for immediate feedback
        activeReviews.Insert(0, newReview);

        // Reset inputs and show success
        reviewerName = "";
        reviewTitle = "";
        reviewComment = "";
        selectedRating = 5;
        submissionSuccess = true;
    }

    private void ResetForm()
    {
        submissionSuccess = false;
        errorMessage = "";
    }
}
