            Rating = 5.0,
            TimeAgo = "1 month ago"
        },
        new StaggeredTestimonials.ReviewItem
        {
            Author = "Angela Brooks",
            Role = "Educator & Parent",
            Initials = "AB",
            AvatarUrl = "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80",
            Title = "Saved our family an ER trip",
            Quote = "Having a board-certified pediatrician available at 10 PM on a Sunday saved us a stressful emergency room trip. Calm, empathetic, and exceptionally professional.",
            Service = "Pediatric Telehealth",
            Category = "Video Telehealth",
            Badge = "Verified Patient",
            Rating = 5.0,
            TimeAgo = "1 month ago"
        }
    };
}
