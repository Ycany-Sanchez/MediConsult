@page "/Error"
@using System.Diagnostics

<PageTitle>Error - MediConsult</PageTitle>

<div class="min-h-screen flex flex-col items-center justify-center text-center px-6 bg-white">
    <div class="max-w-md w-full bg-white p-8 rounded-3xl border border-neutral-200 shadow-sm">
        <span class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </span>
        <h1 class="text-2xl font-bold text-neutral-900 mb-2">An error occurred</h1>
        <p class="text-sm text-neutral-500 mb-6">An unexpected error occurred while processing your request.</p>
        <a href="/" class="motion-btn motion-btn-dark px-7 py-3 rounded-full bg-brand-dark text-white text-sm font-semibold hover:bg-neutral-800 transition">
            Back to Home
        </a>
    </div>
</div>
